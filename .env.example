# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string
MONGODB_URI=

# Database name (optional — defaults to "odyssey_graph" if unset)
MONGODB_DB_NAME=

# Gemini API key — used by the query agent (app/agent.py) and the
# one-off data extraction scripts (scripts/extract_books.py, etc.)
GEMINI_API_KEY=

# Gemini model for the query agent (optional — defaults to "gemini-3.6-flash")
GEMINI_MODEL=

# Voyage AI key — used by app/rag.py to compute query-time embeddings
# (see CLAUDE.md's Vector Search notes for why queries are embedded
# separately from Atlas's write-time Automated Embedding)
VOYAGE_API_KEY=
